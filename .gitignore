# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments (never commit) --------------------------------------
.venv/
venv/
env/

# --- Tool caches ------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Secrets and local configuration (never commit) ---------------------------
# Real credentials belong in the macOS Keychain, not in files.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keychain
*.keychain-db

# --- Local data: database, logs, audit trail (never commit) -------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
*.log
logs/
data/

# --- Model files (large, and licensed separately; never commit) ---------------
models/
*.gguf
*.onnx
*.tflite
*.safetensors
*.bin
*.pt

# --- Audio recordings (may contain private speech; never commit) --------------
*.wav
*.flac
*.mp3
*.m4a

# --- macOS ------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride

# --- Editors ----------------------------------------------------------------
.vscode/
.idea/
*.swp
